@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-4">

    <h2>Events</h2>

    <p>
        <a asp-action="Create" class="btn btn-success">Create Event</a>
    </p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.EventID)</th>
                <th>@Html.DisplayNameFor(model => model.EventName)</th>
                <th>@Html.DisplayNameFor(model => model.EventDate)</th>
                <th>@Html.DisplayNameFor(model => model.Description)</th>
                <th>@Html.DisplayNameFor(model => model.Venue)</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventID</td>
                    <td>@item.EventName</td>
                    <td>@item.EventDate</td>
                    <td>@item.Description</td>
                    <td>@item.Venue?.Location</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.EventID">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.EventID">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.EventID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
